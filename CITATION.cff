    affiliation: "Independent Researcher, Córdoba, Argentina"
    # No ORCID yet. Uncomment and fill once one is registered at
    # <https://orcid.org/register>. This line is left commented out -- rather than
    # carrying an "[ORCID]" placeholder -- because the CFF schema validates the
    # ORCID format strictly, and a placeholder here would make the whole file
    # invalid, which would silently remove GitHub's "Cite this repository" button.
    # orcid: "https://orcid.org/0000-0000-0000-0000"

repository-code: "https://github.com/[GITHUB-USER]/[REPO-NAME]"
url: "https://github.com/[GITHUB-USER]/[REPO-NAME]"
license: MIT
version: "1.0.0"
# Uncomment and set to the date of the release, in YYYY-MM-DD form. Commented out
# for the same reason as orcid above: the schema validates it as a date.
# date-released: 2026-01-01

# The Zenodo DOI minted from the release tag. Zenodo reads this file, so this
# field must be the CONCEPT DOI (the one that always resolves to the latest
# version), not a version-specific DOI.
doi: "10.5281/zenodo.[ZENODO-CONCEPT-RECORD-ID]"

keywords:
  - CRISPR
  - Cas9
  - SaCas9
  - herpes simplex virus
  - HSV-1
  - guide RNA design
  - sequence conservation
  - viral escape
  - off-target
  - reproducible research

